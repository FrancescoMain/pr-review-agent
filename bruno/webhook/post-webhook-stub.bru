meta {
  name: POST webhook github (stub)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/webhook/github
  body: json
  auth: none
}

headers {
  X-GitHub-Event: pull_request
  X-GitHub-Delivery: 00000000-0000-0000-0000-000000000000
  Content-Type: application/json
}

body:json {
  {
    "action": "opened",
    "number": 1,
    "pull_request": {
      "number": 1,
      "title": "stub PR for Bruno smoke",
      "head": { "sha": "deadbeef" },
      "base": { "ref": "main" }
    },
    "repository": {
      "full_name": "francesco/pr-review-agent-playground"
    }
  }
}

assert {
  res.status: eq 202
  res.body.status: eq accepted
}
